# ==========================================
# FreshPredict - Environment Configuration
# ==========================================

# Port for local Express / Dev Server
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL for Production via Neon / Supabase, or SQLite for local)
# Neon / Supabase PostgreSQL example:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/freshpredict?sslmode=require"
# SQLite Local development example:
# DATABASE_URL="file:./dev.db"

# Authentication secret for JWT / Session signing
NEXTAUTH_SECRET="freshpredict-super-secret-key-change-in-production-2026"
NEXTAUTH_URL="http://localhost:3000"

# Application Public URL
APP_URL="http://localhost:3000"
